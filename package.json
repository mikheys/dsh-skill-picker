{
  "name": "@local/dsh-skill-picker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Right-panel skill manager for DeepSeek Harness: per-chat and global skill toggles with Russian descriptions, categories, batched apply, and hidden skills still reachable via /name.",
  "license": "MIT",
  "author": "mikheys",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skills",
    "agent",
    "panel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikheys/dsh-skill-picker.git"
  },
  "homepage": "https://github.com/mikheys/dsh-skill-picker#readme",
  "bugs": {
    "url": "https://github.com/mikheys/dsh-skill-picker/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "russian.json",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
